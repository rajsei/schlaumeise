---
/**
 * DropdownNavItem.astro
 * Minimal, framework-free dropdown toggle for a navbar.
 *
 * Usage:
 * <DropdownNavItem label="Resources">
 *   <a href="/documentation/">Documentation</a>
 *   <a href="/blog/">Blog</a>
 * </DropdownNavItem>
 *
 * You can also pass custom markup as children (e.g. list items).
 */
const {
  label = "Resources",
  buttonId = `dropdown-btn-${Math.random().toString(36).slice(2)}`,
  menuId = `dropdown-menu-${Math.random().toString(36).slice(2)}`,
  buttonClass = "",
  menuClass = "",
  isActive = false,
} = Astro.props;
---

<div class="dropdown" data-dropdown>
  <button
    type="button"
    id={buttonId}
    class={[
      "dropdown__button",
      buttonClass,
      isActive && "is-active",
    ]
      .filter(Boolean)
      .join(" ")}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls={menuId}
    data-dropdown-button
  >
    <span>{label}</span>

    <!-- Arrow icon; rotates when open -->
    <span class="dropdown__arrow" aria-hidden="true" data-dropdown-arrow>
      <svg
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        viewBox="0 0 24 24"
        width="16"
        height="16"
      >
        <path
          d="M8.25 4.5l7.5 7.5-7.5 7.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </span>
  </button>

  <!-- Submenu (positioned under button) -->
  <div
    id={menuId}
    class={["dropdown__menu", menuClass].filter(Boolean).join(" ")}
    role="menu"
    aria-labelledby={buttonId}
    hidden
    data-dropdown-menu
  >
    <slot />
  </div>
</div>

<style>
  /* Minimal functional styling only (positioning + arrow rotation + basic menu behavior). */
  .dropdown {
    position: relative;
    display: inline-block;
  }

  .dropdown__button {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    cursor: pointer;
    background: transparent;
    border: none;
    padding: 0;
    color: inherit;
    font: inherit;
  }

  .dropdown__menu {
    position: absolute;
    top: 100%;
    left: 0;
    /* optional spacing */
    margin-top: 0.25rem;
    /* keep it on top of other nav items */
    z-index: 1000;
    background: var(--sl-color-gray-6);
    border: 1px solid color-mix(in srgb, var(--sl-color-gray-3), transparent 35%);
    border-radius: 0.75rem;
    padding: 0.35rem;
    min-width: 12rem;
    box-shadow: 0 12px 24px rgb(0 0 0 / 0.18);
  }

  .dropdown__menu .dropdown__item {
    display: block;
    width: 100%;
    text-align: left;
  }

  .dropdown__arrow {
    display: inline-flex;
    margin-left: 0.25rem;
    transform: rotate(0deg);
    transition: transform 150ms linear;
  }

  .dropdown[data-open="true"] .dropdown__arrow {
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .dropdown__arrow {
      transition: none;
    }
  }
</style>

<script is:inline>
  // Framework-free dropdown logic.
  // Works for multiple dropdowns on the same page.
  (() => {
    const dropdowns = document.querySelectorAll("[data-dropdown]");

    function closeAll(except = null) {
      dropdowns.forEach((root) => {
        if (except && root === except) return;
        setOpen(root, false);
      });
    }

    function setOpen(root, open) {
      const button = root.querySelector("[data-dropdown-button]");
      const menu = root.querySelector("[data-dropdown-menu]");

      root.dataset.open = open ? "true" : "false";
      button.setAttribute("aria-expanded", open ? "true" : "false");
      menu.hidden = !open;
    }

    dropdowns.forEach((root) => {
      const button = root.querySelector("[data-dropdown-button]");
      const menu = root.querySelector("[data-dropdown-menu]");

      // Safety: ensure initial state
      setOpen(root, false);

      // Toggle on button click
      button.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = root.dataset.open === "true";
        closeAll(root);
        setOpen(root, !isOpen);
      });

      // Close when clicking inside menu links/buttons (optional, common nav behavior)
      menu.addEventListener("click", (e) => {
        const target = e.target;
        if (target && target.closest && target.closest("a, button")) {
          setOpen(root, false);
        }
      });

      // Keyboard: Escape closes and returns focus to button
      root.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          setOpen(root, false);
          button.focus();
        }
      });
    });

    // Close on outside click
    document.addEventListener("click", () => closeAll());

    // Close when focus moves outside (helps keyboard users)
    document.addEventListener("focusin", (e) => {
      const active = e.target;
      const withinAny = Array.from(dropdowns).some((d) => d.contains(active));
      if (!withinAny) closeAll();
    });
  })();
</script>











---
import ThemeController from "../components/ui-elements/ThemeController.astro";
import type { BrandConfig } from "../config/site.config";
import { formatMessage, type Dictionary } from "../i18n";
import type { Locale } from "../i18n/config";
import { buildLocalizedUrl } from "../i18n/routing";

interface Props {
  locale: Locale;
  dictionary: Dictionary;
  brand: BrandConfig;
  languageSwitchHref: string;
}

const { locale, dictionary, brand, languageSwitchHref } = Astro.props;

const homeHref = buildLocalizedUrl(locale, "/");
const homeLabel = formatMessage(dictionary.a11y.brandHome, {
  brand: brand.name,
});
---

<div class="navbar bg-base-100 shadow-sm">
  <div class="navbar-start">
    <div class="dropdown">
      <div tabindex="0" role="button" class="btn btn-outline lg:hidden">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h8m-8 6h16"></path>
        </svg>
      </div>
      <ul
        tabindex="-1"
        class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow"
      >
        <li><a class="button-nav" href={homeHref}>{dictionary.nav.home}</a></li>
        <li>
          <a
            class="button-nav"
            href={languageSwitchHref}
            aria-label={dictionary.a11y.switchLanguage}
          >
            {dictionary.nav.switchTo}
          </a>
        </li>
      </ul>
    </div>
    <div class="btn btn-ghost text-xl">
      <a class="brand" href={homeHref} aria-label={homeLabel}>
        <img
          src={brand.logo.src}
          alt=""
          class="w-9 h-9"
          loading="lazy"
          decoding="async"
        />
        <span class="text-xl">{brand.name}</span>
      </a>
    </div>
  </div>

  <div class="navbar-center hidden lg:flex">
    <ul class="menu menu-horizontal px-1">
      <li><a class="button-nav" href={homeHref}>{dictionary.nav.home}</a></li>

      <li><a class="button-nav">Item 1</a></li>

      <details class="dropdown">
        <summary class="button-nav m-1">open or close</summary>
        <ul
          class="menu dropdown-content bg-base-100 rounded-box z-1 w-52 p-2 shadow-sm"
        >
          <li><a>Item 1</a></li>
          <li><a>Item 2</a></li>
        </ul>
      </details>

      <li>
        <a class="button-nav">Parent</a>
        <ul
          class="menu dropdown-content bg-base-100 rounded-box z-1 w-52 p-2 shadow-sm"
        >
          <li><a class="button-nav dropdown-item">Submenu 1</a></li>
          <li><a class="button-nav dropdown-item">Submenu 2</a></li>
        </ul>
      </li>
      <li><a class="button-nav">Item 3</a></li>

      <li>
        <a
          class="button-nav"
          href={languageSwitchHref}
          aria-label={dictionary.a11y.switchLanguage}
        >
          {dictionary.nav.switchTo}
        </a>
      </li>
    </ul>
  </div>
  <div class="navbar-end">
    <ThemeController />
  </div>
</div>

<style>
  .button-nav {
    font-size: larger;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--sl-color-white);
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
</style>















<style is:global>
  .docs-code-block {
    margin: var(--spacing-md) 0;
    border: var(--border-sm);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-panel);
  }

  .docs-code-block__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
    min-height: 2.25rem;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-bottom: 1px solid var(--docs-code-border);
    background: var(--docs-code-header-bg);
  }

  .docs-code-block__title {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--docs-code-title-text);
  }

  .docs-code-block__language {
    margin-left: auto;
    font-size: var(--font-size-xs);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--docs-code-header-text);
  }

  .docs-code-block__language.is-secondary {
    margin-left: var(--spacing-xs);
  }

  .docs-code-block__body {
    position: relative;
  }

  .docs-code-block .docs-code-block__pre {
    margin: 0;
    border: 0;
    border-radius: 0;
  }

  .docs-code-block .docs-code-block__pre code {
    display: block;
    padding: var(--spacing-md);
    overflow-x: auto;
  }

  .docs-code-block.is-wrap .docs-code-block__pre code {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .docs-code-block .line.is-highlighted {
    background: var(--docs-code-highlight);
  }

  .docs-code-block.has-line-numbers .line {
    position: relative;
    display: block;
    padding-left: 2.2rem; /* bespoke: Zeilennummern-Gutter */
  }

  .docs-code-block.has-line-numbers .line::before {
    content: attr(data-line);
    position: absolute;
    left: 0;
    width: 1.65rem;
    text-align: right;
    color: var(--docs-code-line-number);
    user-select: none;
  }

  .docs-code-block__copy {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    border: 1px solid var(--docs-copy-btn-border);
    border-radius: var(--radius-sm);
    background: var(--docs-copy-btn-bg);
    color: var(--docs-copy-btn-text);
    width: 2rem;
    height: 2rem;
    display: inline-grid;
    place-items: center;
    font-size: 0;
    line-height: 1;
    padding: 0;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-2px);
    transition: border-color 120ms ease, transform 120ms ease, opacity 120ms ease;
  }

  .docs-code-block__body:hover .docs-code-block__copy,
  .docs-code-block__body:focus-within .docs-code-block__copy {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .docs-code-block__copy:hover,
  .docs-code-block__copy:focus-visible {
    border-color: color-mix(in srgb, var(--color-accent), transparent 35%);
    transform: translateY(-1px);
  }

  .docs-code-block__copy:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent), transparent 30%);
    outline-offset: 1px;
  }

  .docs-code-block__copy[data-copied="true"] {
    border-color: color-mix(in srgb, var(--color-highlight-green), transparent 30%);
  }

  @media (max-width: 640px) {
    .docs-code-block__copy {
      top: 0.45rem;
      right: 0.45rem;
      width: 1.8rem;
      height: 1.8rem;
    }
  }
</style>

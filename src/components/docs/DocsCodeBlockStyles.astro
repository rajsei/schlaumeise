<style is:global>
  .docs-code-block {
    margin: var(--spacing-md) 0;
    border: var(--border-sm);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-panel);
  }

  /* Shiki Dual-Theme: im Dark-/Dark-Contrast-Mode die dunkle Palette aktivieren.
     Astro/Shiki liefert die --shiki-dark*-Variablen inline, aktiviert sie aber nicht
     selbst -> ohne diese Regel bleiben Code-Bloecke im Dark-Mode hell. */
  :root[data-theme="dark"] .astro-code,
  :root[data-theme="dark-contrast"] .astro-code {
    background-color: var(--shiki-dark-bg) !important;
  }

  :root[data-theme="dark"] .astro-code,
  :root[data-theme="dark"] .astro-code span,
  :root[data-theme="dark-contrast"] .astro-code,
  :root[data-theme="dark-contrast"] .astro-code span {
    color: var(--shiki-dark) !important;
  }

  .docs-code-block__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
    min-height: 2.25rem;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-bottom: 1px solid var(--docs-code-border);
    background: var(--docs-code-header-bg);
  }

  .docs-code-block__title {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--docs-code-title-text);
  }

  .docs-code-block__language {
    margin-left: auto;
    font-size: var(--font-size-xs);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--docs-code-header-text);
  }

  .docs-code-block__language.is-secondary {
    margin-left: var(--spacing-xs);
  }

  .docs-code-block__body {
    position: relative;
  }

  /* Kopier-Affordanz: die gesamte Flaeche ist per Klick kopierbar (docs-code-copy.ts)
     -> Copy-Cursor. Direkt ueber dem Text bleibt der Text-Cursor, damit Markieren
     weiterhin natuerlich wirkt. */
  .docs-code-block__body[data-docs-copy-surface] {
    cursor: copy;
  }

  .docs-code-block__body[data-docs-copy-surface] .line {
    cursor: text;
  }

  .docs-code-block .docs-code-block__pre {
    margin: 0;
    border: 0;
    border-radius: 0;
  }

  .docs-code-block .docs-code-block__pre code {
    display: block;
    padding: var(--spacing-md);
    overflow-x: auto;
  }

  .docs-code-block.is-wrap .docs-code-block__pre code {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .docs-code-block .line.is-highlighted {
    background: var(--docs-code-highlight);
  }

  .docs-code-block.has-line-numbers .line {
    position: relative;
    display: block;
    padding-left: 2.2rem; /* bespoke: Zeilennummern-Gutter */
  }

  .docs-code-block.has-line-numbers .line::before {
    content: attr(data-line);
    position: absolute;
    left: 0;
    width: 1.65rem;
    text-align: right;
    color: var(--docs-code-line-number);
    user-select: none;
  }

  .docs-code-block__copy {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 1;
    border: 1px solid var(--docs-copy-btn-border);
    border-radius: var(--radius-sm);
    background: var(--docs-copy-btn-bg);
    color: var(--docs-copy-btn-text);
    width: 2rem;
    height: 2rem;
    display: inline-grid;
    place-items: center;
    padding: 0;
    cursor: copy;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-2px);
    transition: border-color 120ms ease, transform 120ms ease, opacity 120ms ease;
  }

  .docs-code-block__body:hover .docs-code-block__copy,
  .docs-code-block__body:focus-within .docs-code-block__copy {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .docs-code-block__copy:hover,
  .docs-code-block__copy:focus-visible {
    border-color: color-mix(in srgb, var(--color-accent), transparent 35%);
    transform: translateY(-1px);
  }

  .docs-code-block__copy:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent), transparent 30%);
    outline-offset: 1px;
  }

  .docs-code-block__copy[data-copied="true"] {
    border-color: color-mix(in srgb, var(--color-highlight-green), transparent 30%);
  }

  @media (max-width: 640px) {
    .docs-code-block__copy {
      top: 0.4rem;
      right: 0.4rem;
      width: 1.8rem;
      height: 1.8rem;
    }

    /* Rechter Freiraum, damit der dauerhaft sichtbare Button keine Schrift verdeckt. */
    .docs-code-block .docs-code-block__pre code {
      padding-right: 2.9rem; /* bespoke: an feste Button-Groesse (1.8rem) gekoppelt, darf nicht mit --spacing-* schrumpfen */
    }
  }

  /* Scroll-Affordanz: rechter Kanten-Schatten, wenn der Code-Block horizontal
     scrollbar ist und noch nicht am Ende (data-xscroll via docs-scroll-shadow.ts).
     Overlay (kein Hintergrund-Cover), da Shiki einen eigenen Hintergrund mitbringt. */
  .docs-code-block__body[data-xscroll]::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--spacing-lg);
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms ease;
    background: linear-gradient(to left, var(--color-gray-transparent), transparent);
  }

  .docs-code-block__body[data-xscroll="more"]::after {
    opacity: 1;
  }

  /* Touch-/Schmal-Screens: Copy-Button dauerhaft sichtbar, da :hover/:focus-within dort
     nicht greift. Tap-Target ~36px: gross genug zum Tippen, aber kompakt genug, dass er
     auf kurzen (einzeiligen) Bloecken nicht unten ueberlaeuft. Die gesamte Flaeche ist
     ohnehin antippbar zum Kopieren. Nach der 640px-Regel, damit es gewinnt. */
  @media (pointer: coarse), (max-width: 640px) {
    .docs-code-block__copy {
      opacity: 1;
      pointer-events: auto;
      transform: none;
      top: 0.4rem;
      right: 0.4rem;
      width: 2.25rem;
      height: 2.25rem;
    }

    .docs-code-block .docs-code-block__pre code {
      padding-right: 3.1rem; /* bespoke: an feste Button-Groesse (2.25rem) gekoppelt, darf nicht mit --spacing-* schrumpfen */
    }
  }
</style>

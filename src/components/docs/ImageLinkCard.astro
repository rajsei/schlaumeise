---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"a">, "title" | "href"> {
  title: string;
  href: string;
  description?: string;
  imgSrc?: string;
  imgAlt?: string;
  isExternal?: boolean;
}

const {
  title,
  href,
  description,
  imgSrc,
  imgAlt = "",
  isExternal = false,
  class: className = "",
  ...attributes
} = Astro.props;

const rootClass = ["sl-link-card", "sl-link-card--image", className].filter(Boolean).join(" ");
---

<a class={rootClass} href={href} {...attributes}>
  {imgSrc && <img src={imgSrc} alt={imgAlt} class="sl-link-card__image" loading="lazy" decoding="async" />}

  <span class="sl-flex stack">
    <span class="title">{title}</span>
    {description && <span class="description">{description}</span>}
  </span>

  {
    isExternal ? (
      <svg aria-hidden="true" class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M20 4L12 12M20 4V8.5M20 4H15.5M19 12.5V16.8C19 17.9201 19 18.4802 18.782 18.908C18.5903 19.2843 18.2843 19.5903 17.908 19.782C17.4802 20 16.9201 20 15.8 20H7.2C6.0799 20 5.51984 20 5.09202 19.782C4.71569 19.5903 4.40973 19.2843 4.21799 18.908C4 18.4802 4 17.9201 4 16.8V8.2C4 7.0799 4 6.51984 4.21799 6.09202C4.40973 5.71569 4.71569 5.40973 5.09202 5.21799C5.51984 5 6.07989 5 7.2 5H11.5" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    ) : (
      <svg aria-hidden="true" class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" transform="matrix(-1, 0, 0, 1, 0, 0)">
        <path d="M5 12H19M5 12L11 6M5 12L11 18" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    )
  }
</a>

<style>
  .sl-link-card {
    display: grid;
    grid-template-columns: minmax(0, 60%) minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid var(--sl-color-gray-5, var(--color-gray-5));
    border-radius: 0.5rem;
    padding: 0.85rem;
    box-shadow: var(--sl-shadow-sm, 0 1px 2px rgb(0 0 0 / 0.18));
    position: relative;
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .sl-link-card:hover {
    border-color: var(--sl-color-gray-3, var(--color-gray-3));
    background: color-mix(in srgb, var(--color-gray-6), transparent 72%);
  }

  .sl-link-card__image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    object-fit: cover;
    box-shadow: 0 0 6px rgb(0 0 0 / 0.2);
  }

  .sl-flex {
    display: flex;
  }

  .stack {
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
  }

  .title {
    color: var(--sl-color-white, var(--color-white));
    font-weight: 600;
    font-size: var(--sl-text-lg, 1.125rem);
    line-height: var(--sl-line-height-headings, 1.3);
    overflow-wrap: anywhere;
  }

  .description {
    color: var(--sl-color-gray-3, var(--color-gray-3));
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .icon {
    color: var(--sl-color-gray-3, var(--color-gray-3));
    width: 1em;
    height: 1em;
    font-size: var(--sl-icon-size, 1.333em);
    align-self: start;
    margin-top: 0.2rem;
  }

  .sl-link-card:hover .icon {
    color: var(--sl-color-white, var(--color-white));
  }

  @media (max-width: 900px) {
    .sl-link-card {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.65rem;
    }

    .sl-link-card__image {
      grid-column: 1 / -1;
      width: 100%;
      max-width: 100%;
    }
  }
</style>

---
import type { ResolvedSidebarItem } from "../../lib/docs/navigation";

interface Props {
  items: ResolvedSidebarItem[];
}

const { items } = Astro.props;
---

{
  items.map((item) =>
    item.type === "divider" ? (
      <li class="docs-nav__divider" aria-hidden="true">
        <hr />
      </li>
    ) : item.type === "link" ? (
      <li>
        <a
          href={item.href}
          class:list={["docs-nav__link", item.isActive && "is-active"]}
          aria-current={item.isActive ? "page" : undefined}
          {...item.attrs}
        >
          {item.label}
        </a>
      </li>
    ) : (
      <li>
        <details open={!item.collapsed || item.isActive} class="docs-nav__group">
          <summary class:list={["docs-nav__group_label", item.isActive && "is-active"]}>
            {item.label}
          </summary>
          <ul class="docs-nav__items">
            <Astro.self items={item.items} />
          </ul>
        </details>
      </li>
    ),
  )
}

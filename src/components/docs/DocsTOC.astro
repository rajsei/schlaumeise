---
import type { MarkdownHeading } from "astro";
import type { Locale } from "../../i18n/config";
import { getDictionary } from "../../i18n";

interface Props {
  locale: Locale;
  headings: MarkdownHeading[];
  showHeading?: boolean;
}

const { locale, headings, showHeading = true } = Astro.props;
const dictionary = getDictionary(locale);
const visibleHeadings = headings.filter((heading) => heading.depth <= 4);
---

<nav class="docs-toc" aria-label={dictionary.docs.tocHeading}>
  {showHeading && <h2 class="docs-toc__heading">{dictionary.docs.tocHeading}</h2>}
  {
    visibleHeadings.length > 0 ? (
      <ul class="docs-toc__list">
        {visibleHeadings.map((heading) => (
          <li
            class="docs-toc__item"
            style={`--toc-level:${Math.max(1, heading.depth - 1)};`}
          >
            <a
              href={`#${heading.slug}`}
              class:list={["docs-toc__link", heading.depth > 2 && "docs-toc__link--nested"]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="docs-toc__empty">{dictionary.docs.noTocItems}</p>
    )
  }
</nav>

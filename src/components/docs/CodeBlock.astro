---
import { Code } from "astro:components";
import { parseLineSelection } from "../../plugins/code-block-meta.mjs";
import { createDocsCodeTransformer } from "../../plugins/shiki-transformer-docs-code.mjs";

interface Props {
  code: string;
  lang?: string;
  title?: string;
  copy?: boolean;
  wrap?: boolean;
  theme?: string | { light: string; dark: string };
  class?: string;
  showLineNumbers?: boolean;
  highlight?: string | number[];
  meta?: string;
}

const {
  code,
  lang = "text",
  title,
  copy = true,
  wrap = false,
  theme,
  class: className = "",
  showLineNumbers = false,
  highlight,
  meta = "",
} = Astro.props;

const isTerminalStyle = /\bterminal-code\b/.test(className);
const neutralLanguages = new Set(["text", "plaintext", "txt", "console"]);
const hasUsefulLanguage = Boolean(lang) && !neutralLanguages.has(lang.toLowerCase());
const showHeader = Boolean(title) || hasUsefulLanguage;

const aliases = {
  js: "JavaScript",
  ts: "TypeScript",
  sh: "Shell",
  bash: "Bash",
  yml: "YAML",
  md: "Markdown",
  html: "HTML",
  css: "CSS",
  json: "JSON",
  py: "Python",
  text: "Text",
  plaintext: "Text",
};

const langKey = lang.toLowerCase();
const languageLabel = aliases[langKey as keyof typeof aliases]
  ?? (lang.toUpperCase() === lang ? lang : `${lang.charAt(0).toUpperCase()}${lang.slice(1)}`);

const highlightedLines = Array.isArray(highlight)
  ? [...new Set(highlight.filter((line) => Number.isInteger(line) && line > 0))].sort((a, b) => a - b)
  : parseLineSelection(highlight ?? "");

const escapeAttribute = (value: string) => value.replace(/"/g, "\\\"");

const metaParts = [meta.trim()];
if (title) {
  metaParts.push(`title="${escapeAttribute(title)}"`);
}
metaParts.push(copy ? "copy" : "nocopy");
if (wrap) {
  metaParts.push("wrap");
}
if (showLineNumbers) {
  metaParts.push("showLineNumbers");
}
if (highlightedLines.length > 0) {
  metaParts.push(`highlight={${highlightedLines.join(",")}}`);
}

const resolvedMeta = metaParts.filter(Boolean).join(" ");
const resolvedTheme = theme ?? (isTerminalStyle ? "github-dark" : { light: "github-light", dark: "github-dark" });

const wrapperClass = [
  "docs-code-block",
  "docs-code-block--component",
  wrap ? "is-wrap" : "",
  showLineNumbers ? "has-line-numbers" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<figure class={wrapperClass}>
  {
    showHeader && (
      <figcaption class="docs-code-block__header">
        {title && <span class="docs-code-block__title">{title}</span>}
        {!title && hasUsefulLanguage && <span class="docs-code-block__language">{languageLabel}</span>}
        {title && hasUsefulLanguage && <span class="docs-code-block__language is-secondary">{languageLabel}</span>}
      </figcaption>
    )
  }

  <div
    class="docs-code-block__body"
    data-docs-copy-surface={copy ? "true" : undefined}
    data-copy-source={copy ? code : undefined}
  >
    <Code
      code={code}
      lang={lang}
      theme={resolvedTheme}
      meta={resolvedMeta}
      transformers={[createDocsCodeTransformer()]}
    />

    {
      copy && (
        <button
          type="button"
          class="docs-code-block__copy"
          data-docs-copy-button
          data-copy-label="Copy"
          data-copied-label="Copied"
          data-copy-source={code}
          aria-label="Copy code to clipboard"
        >
          <span class="sr-only">Copy</span>
        </button>
      )
    }
  </div>
</figure>

<script>
  import "../../scripts/docs-code-copy";
</script>

<style is:global>
  .docs-code-block {
    margin: 1rem 0;
    border: 1px solid var(--docs-code-border);
    border-radius: 0.75rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-black), black 6%);
  }

  .docs-code-block__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    min-height: 2.25rem;
    padding: 0.45rem 0.8rem;
    border-bottom: 1px solid var(--docs-code-border);
    background: var(--docs-code-header-bg);
  }

  .docs-code-block__title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--docs-code-title-text);
  }

  .docs-code-block__language {
    margin-left: auto;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--docs-code-header-text);
  }

  .docs-code-block__language.is-secondary {
    margin-left: 0.4rem;
  }

  .docs-code-block__body {
    position: relative;
  }

  .docs-code-block__pre {
    margin: 0;
    border: 0;
    border-radius: 0;
  }

  .docs-code-block__pre code {
    display: block;
    padding: 0.9rem 1rem;
    overflow-x: auto;
  }

  .docs-code-block.is-wrap .docs-code-block__pre code {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .docs-code-block .line.is-highlighted {
    background: var(--docs-code-highlight);
  }

  .docs-code-block.has-line-numbers .line {
    position: relative;
    display: block;
    padding-left: 2.2rem;
  }

  .docs-code-block.has-line-numbers .line::before {
    content: attr(data-line);
    position: absolute;
    left: 0;
    width: 1.65rem;
    text-align: right;
    color: var(--docs-code-line-number);
    user-select: none;
  }

  .docs-code-block__copy {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    border: 1px solid var(--docs-copy-btn-border);
    border-radius: 0.45rem;
    background: var(--docs-copy-btn-bg);
    color: var(--docs-copy-btn-text);
    width: 2rem;
    height: 2rem;
    display: inline-grid;
    place-items: center;
    font-size: 0;
    line-height: 1;
    padding: 0;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-2px);
    transition: border-color 120ms ease, transform 120ms ease, opacity 120ms ease;
  }

  .docs-code-block__copy::before {
    content: "⧉";
    font-size: 1rem;
    line-height: 1;
  }

  .docs-code-block__copy[data-copied="true"]::before {
    content: "✓";
    font-size: 0.95rem;
  }

  .docs-code-block__body:hover .docs-code-block__copy,
  .docs-code-block__body:focus-within .docs-code-block__copy {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .docs-code-block__copy:hover,
  .docs-code-block__copy:focus-visible {
    border-color: color-mix(in srgb, var(--color-accent), transparent 35%);
    transform: translateY(-1px);
  }

  .docs-code-block__copy:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-accent), transparent 30%);
    outline-offset: 1px;
  }

  .docs-code-block__copy[data-copied="true"] {
    border-color: color-mix(in srgb, var(--color-highlight-green), transparent 30%);
  }

  .docs-code-block.terminal-code {
    border-color: #2f3a4d;
    background: #0d1117;
    color: #d2d9e6;
  }

  .docs-code-block.terminal-code .docs-code-block__header {
    border-bottom-color: #2f3a4d;
    background: #131a25;
  }

  .docs-code-block.terminal-code .docs-code-block__title {
    color: #d2d9e6;
  }

  .docs-code-block.terminal-code .docs-code-block__language {
    color: #aab4c6;
  }

  .docs-code-block.terminal-code .docs-code-block__pre,
  .docs-code-block.terminal-code .docs-code-block__pre code,
  .docs-code-block.terminal-code .astro-code {
    background: #0d1117 !important;
    color: #d2d9e6;
  }

  .docs-code-block.terminal-code pre.astro-code,
  .docs-code-block.terminal-code pre.docs-code-pre {
    padding: 0.95rem 1rem 0.95rem 1.2rem !important;
  }

  .docs-code-block.terminal-code pre.astro-code code,
  .docs-code-block.terminal-code pre.docs-code-pre code {
    padding: 0 !important;
  }

  .docs-code-block.terminal-code.has-line-numbers .line::before {
    color: #7e8da4;
  }

  .docs-code-block.terminal-code .docs-code-block__copy {
    border-color: #3b4b66;
    background: #121a28;
    color: #d2d9e6;
  }

  .docs-code-block.terminal-code .docs-code-block__copy:hover,
  .docs-code-block.terminal-code .docs-code-block__copy:focus-visible {
    border-color: #73b7ff;
  }

  @media (max-width: 640px) {
    .docs-code-block__copy {
      top: 0.45rem;
      right: 0.45rem;
      width: 1.8rem;
      height: 1.8rem;
    }
  }
</style>

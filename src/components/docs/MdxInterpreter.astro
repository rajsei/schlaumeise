---
import DocsCodeBlockStyles from "./DocsCodeBlockStyles.astro";
---

<DocsCodeBlockStyles />

<div class="mdx-interpreter">
  <slot />
</div>

<script>
  import "../../scripts/docs-code-copy";
  import "../../scripts/docs-scroll-shadow";
</script>

<style is:global>
  .mdx-interpreter > :first-child {
    margin-top: 0;
  }

  .mdx-interpreter > :last-child {
    margin-bottom: 0;
  }

  .mdx-interpreter :where(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-sm);
  }

  .mdx-interpreter :where(h2) {
    font-size: var(--font-size-h2);
    border-bottom: var(--border-sm);
    padding-bottom: var(--spacing-2xs);
  }

  .mdx-interpreter :where(h3) {
    font-size: var(--font-size-h3);
  }

  .mdx-interpreter :where(h4, h5, h6) {
    font-size: var(--font-size-md);
  }

  .mdx-interpreter :where(p, ul, ol, blockquote, table, hr) {
    margin-top: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }

  .mdx-interpreter :where(pre) {
    margin-top: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }

  .mdx-interpreter :where(ul, ol) {
    padding-left: var(--spacing-lg);
  }

  .mdx-interpreter :where(ul) {
    list-style: disc;
  }

  .mdx-interpreter :where(ol) {
    list-style: decimal;
  }

  .mdx-interpreter :where(li) {
    margin-top: var(--spacing-2xs);
    margin-bottom: var(--spacing-2xs);
  }

  .mdx-interpreter :where(li > ul, li > ol) {
    margin-top: var(--spacing-2xs);
    margin-bottom: var(--spacing-2xs);
  }

  .mdx-interpreter :where(a) {
    color: var(--color-accent-strong);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 0.08em;
  }

  .mdx-interpreter :where(strong) {
    font-weight: var(--font-weight-bold);
  }

  .mdx-interpreter :where(code):not(pre code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.9em;
    background: var(--color-accent-subtle);
    border: 1px solid var(--color-accent-strong);
    border-radius: var(--radius-sm);
    padding: var(--spacing-3xs) var(--spacing-2xs);
  }

  .mdx-interpreter :where(pre):not(.astro-code):not(.docs-terminal__pre) {
    border-radius: var(--radius-md);
    border: var(--border-sm);
    padding: var(--spacing-sm);
    overflow-x: auto;
    background: var(--color-surface-panel);
  }

  .mdx-interpreter :where(pre):not(.astro-code):not(.docs-terminal__pre) code {
    background: transparent;
    border: 0;
    padding: 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
  }

  .mdx-interpreter :where(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding: var(--spacing-2xs) 0 var(--spacing-2xs) var(--spacing-sm);
    color: var(--color-text);
    font-style: italic;
  }

  .mdx-interpreter :where(table) {
    width: 100%;
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
    /* Scroll-Affordanz (CSS-Scroll-Shadows): Schatten an den Raendern erscheinen nur,
       wenn die Tabelle horizontal scrollbar ist, und verschwinden am jeweiligen Ende.
       Cover-Gradienten (background-attachment: local) verdecken den Schatten am Start/
       Ende; Schatten-Gradienten (scroll) liegen fest an den Kanten. Theme-aware ueber
       --color-surface-panel (Cover) und --color-gray-transparent (Schatten). */
    background:
      linear-gradient(to right, var(--color-surface-panel) 30%, transparent) 0 0,
      linear-gradient(to right, transparent, var(--color-surface-panel) 70%) 100% 0,
      radial-gradient(farthest-side at 0 50%, var(--color-gray-transparent), transparent) 0 0,
      radial-gradient(farthest-side at 100% 50%, var(--color-gray-transparent), transparent) 100% 0;
    background-repeat: no-repeat;
    background-size:
      var(--spacing-xl) 100%,
      var(--spacing-xl) 100%,
      var(--spacing-sm) 100%,
      var(--spacing-sm) 100%;
    background-attachment: local, local, scroll, scroll;
  }

  .mdx-interpreter :where(th, td) {
    border: var(--border-sm);
    padding: var(--spacing-xs) var(--spacing-sm);
    text-align: left;
    vertical-align: top;
  }

  .mdx-interpreter :where(th) {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-accent), transparent 84%);
  }

  .mdx-interpreter :where(hr) {
    border: 0;
    border-top: var(--border-sm);
  }

  .mdx-interpreter .docs-code-block__copy::before,
  .mdx-interpreter .docs-code-block__copy::after {
    content: none !important;
    display: none !important;
  }

  .mdx-interpreter :where(.docs-code-block__copy-icon-wrap) {
    position: relative;
    width: 1rem;
    height: 1rem;
    display: inline-grid;
    place-items: center;
    pointer-events: none;
  }

  .mdx-interpreter :where(.docs-code-block__copy-icon, .docs-code-block__copied-icon) {
    position: absolute;
    inset: 0;
    width: 1rem;
    height: 1rem;
    pointer-events: none;
    transition: opacity 120ms ease, transform 120ms ease;
  }

  .mdx-interpreter :where(.docs-code-block__copy-icon) {
    display: block;
    opacity: 1;
    transform: scale(1);
  }

  .mdx-interpreter :where(.docs-code-block__copied-icon) {
    display: none;
    opacity: 0;
    transform: scale(0.9);
  }

  .mdx-interpreter :where(.docs-code-block__copy[data-copied="true"] .docs-code-block__copy-icon) {
    display: none;
    opacity: 0;
    transform: scale(0.9);
  }

  .mdx-interpreter :where(.docs-code-block__copy[data-copied="true"] .docs-code-block__copied-icon) {
    display: block;
    opacity: 1;
    transform: scale(1);
  }

  .mdx-interpreter :where(.docs-code-block .astro-code) {
    overflow-x: auto;
  }

  @media (max-width: 640px) {
    .mdx-interpreter :where(ul, ol) {
      padding-left: var(--spacing-md);
    }
  }
</style>

---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

type CardIcon = "arrow" | "external" | "none";

interface Props extends Omit<HTMLAttributes<"a">, "title" | "href"> {
  title: string;
  href: string;
  description?: string;
  /** Importierte Bilddatei (ImageMetadata, wird optimiert) oder URL-String. */
  imgSrc?: string | ImageMetadata;
  imgAlt?: string;
  isExternal?: boolean;
  icon?: CardIcon | false;
}

const {
  title,
  href,
  description,
  imgSrc,
  imgAlt = "",
  isExternal = false,
  icon,
  class: className = "",
  ...attributes
} = Astro.props;

const hasImage = Boolean(imgSrc);
const resolvedIcon = icon === false ? "none" : icon ?? (isExternal ? "external" : "arrow");
const rootClass = [
  "sl-link-card",
  "card",
  "card-border",
  "bg-base-100",
  "text-base-content",
  "shadow-sm",
  hasImage ? "sl-link-card--image" : "",
  resolvedIcon === "none" ? "sl-link-card--no-icon" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<a class={rootClass} href={href} {...attributes}>
  {
    imgSrc && (
      <figure class="sl-link-card__media">
        {typeof imgSrc === "string" ? (
          <img src={imgSrc} alt={imgAlt} class="sl-link-card__image not-zoomable" loading="lazy" decoding="async" />
        ) : (
          <Image
            src={imgSrc}
            alt={imgAlt}
            width={Math.min(640, imgSrc.width)}
            class="sl-link-card__image not-zoomable"
            loading="lazy"
            decoding="async"
          />
        )}
      </figure>
    )
  }

  <span class="sl-link-card__body card-body">
    <span class="sl-link-card__text">
      <span class="sl-link-card__title card-title">{title}</span>
      {description && <span class="sl-link-card__description">{description}</span>}
    </span>

    {
      resolvedIcon === "external" && (
        <svg aria-hidden="true" class="sl-link-card__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 4L12 12M20 4V8.5M20 4H15.5M19 12.5V16.8C19 17.9201 19 18.4802 18.782 18.908C18.5903 19.2843 18.2843 19.5903 17.908 19.782C17.4802 20 16.9201 20 15.8 20H7.2C6.0799 20 5.51984 20 5.09202 19.782C4.71569 19.5903 4.40973 19.2843 4.21799 18.908C4 18.4802 4 17.9201 4 16.8V8.2C4 7.0799 4 6.51984 4.21799 6.09202C4.40973 5.71569 4.71569 5.40973 5.09202 5.21799C5.51984 5 6.07989 5 7.2 5H11.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      )
    }

    {
      resolvedIcon === "arrow" && (
        <svg aria-hidden="true" class="sl-link-card__icon rtl:flip" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" transform="matrix(-1, 0, 0, 1, 0, 0)">
          <path d="M5 12H19M5 12L11 6M5 12L11 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      )
    }
  </span>
</a>

<style>
  .sl-link-card {
    --card-p: 1rem;
    display: block;
    width: 100%;
    /* Kontrast-bewusster Rand: --color-border-base verstaerkt sich in den
       High-Contrast-Themes automatisch (statt eines festen currentColor-Anteils,
       der dort blass bleibt). */
    border-color: var(--color-border-base);
    color: var(--color-text);
    text-decoration: none;
    line-height: var(--sl-line-height-headings, 1.3);
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .sl-link-card:hover,
  .sl-link-card:focus-visible {
    border-color: var(--color-accent);
    background: var(--color-surface-page);
    outline: none;
  }

  .sl-link-card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .sl-link-card--image {
    --card-p: 0.85rem;
    /* Innere Rundung des Bilds: konzentrisch zur Card-Rundung, mit Untergrenze. */
    --link-card-img-radius: max(calc(var(--radius-box, 1rem) - var(--card-p)), 0.375rem);
    display: grid;
    /* Feste Bildspalte: Bildgroesse ist unabhaengig von der Fenstergroesse. */
    grid-template-columns: 12rem minmax(0, 1fr);
    align-items: center;
  }

  .sl-link-card__media {
    margin: 0;
    min-width: 0;
    align-self: center;
    /* Inset statt randbuendig: haelt immer Abstand zum Card-Rand (links/oben/unten).
       Rechts uebernimmt das Body-Padding den Abstand zum Text. */
    padding: var(--card-p) 0 var(--card-p) var(--card-p);
  }

  .sl-link-card__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: var(--link-card-img-radius);
  }

  .sl-link-card__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--spacing-xs);
    min-width: 0;
  }

  .sl-link-card--no-icon .sl-link-card__body {
    grid-template-columns: minmax(0, 1fr);
  }

  .sl-link-card--image .sl-link-card__body {
    align-items: start;
    gap: var(--spacing-sm);
  }

  .sl-link-card__text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    min-width: 0;
  }

  .sl-link-card__title {
    color: inherit;
    overflow-wrap: anywhere;
  }

  .sl-link-card__description {
    color: color-mix(in oklab, var(--color-text) 68%, transparent);
    line-height: var(--line-height-normal);
    overflow-wrap: anywhere;
  }

  .sl-link-card__icon {
    width: 1.15rem;
    height: 1.15rem;
    color: color-mix(in oklab, var(--color-text) 72%, transparent);
    align-self: center;
    transition: color 0.15s ease;
  }

  .sl-link-card--image .sl-link-card__icon {
    align-self: start;
    margin-top: var(--spacing-3xs);
  }

  .sl-link-card:hover .sl-link-card__icon,
  .sl-link-card:focus-visible .sl-link-card__icon {
    color: var(--color-text);
  }

  /* Erst auf schmalen Viewports (unter sm) stapeln; dank fester 12rem-Bildspalte
     funktioniert das Nebeneinander auch auf mittleren Breiten gut. */
  @media (max-width: 639px) {
    .sl-link-card--image {
      grid-template-columns: minmax(0, 1fr);
    }

    .sl-link-card__media {
      /* Gestapelt: Inset rundum ausser unten, dort schliesst der Body an. */
      padding: var(--card-p) var(--card-p) 0;
    }

    .sl-link-card__image {
      /* Feste Groesse auch gestapelt (15 x 9rem), zentriert - skaliert nicht
         mit dem Fenster. Schrumpft nur, wenn die Card selbst schmaler ist.
         object-fit: cover beschneidet statt zu verzerren. */
      height: 9rem;
      width: min(100%, 15rem);
      margin-inline: auto;
    }
  }
</style>

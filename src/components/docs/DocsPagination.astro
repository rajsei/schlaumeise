---
import type { ResolvedDocsPaginationLink } from "../../lib/docs-navigation";

interface Props {
  ariaLabel: string;
  prevLabel: string;
  nextLabel: string;
  prev: ResolvedDocsPaginationLink | null;
  next: ResolvedDocsPaginationLink | null;
}

const { ariaLabel, prevLabel, nextLabel, prev, next } = Astro.props;
const hasPagination = Boolean(prev || next);
---

{
  hasPagination && (
    <nav class="docs-pagination" aria-label={ariaLabel}>
      {prev && (
        <a class="docs-pagination__link docs-pagination__link--prev" href={prev.href}>
          <span class="docs-pagination__caption">{"\u2190"} {prevLabel}</span>
          <span class="docs-pagination__title">{prev.label}</span>
        </a>
      )}

      {next && (
        <a class="docs-pagination__link docs-pagination__link--next" href={next.href}>
          <span class="docs-pagination__caption">
            {nextLabel} {"\u2192"}
          </span>
          <span class="docs-pagination__title">{next.label}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .docs-pagination {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .docs-pagination__link {
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    padding: 0.9rem 1rem;
    min-height: 4.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
    width: 100%;
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
    background-color: color-mix(in srgb, currentColor 2%, transparent);
  }

  .docs-pagination__link:hover,
  .docs-pagination__link:focus-visible {
    border-color: color-mix(in srgb, currentColor 30%, transparent);
    background-color: color-mix(in srgb, currentColor 5%, transparent);
    outline: none;
  }

  .docs-pagination__caption {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.82;
  }

  .docs-pagination__title {
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.35;
    word-break: break-word;
  }

  .docs-pagination__link--next {
    grid-column: 2;
    text-align: right;
  }

  @media (max-width: 640px) {
    .docs-pagination {
      grid-template-columns: 1fr;
    }

    .docs-pagination__link--next {
      grid-column: auto;
    }
  }
</style>

---
/**
 * Bildkarussell im "Minimal Clean"-Stil:
 * Freistehendes Bild mit weichem Schatten, Bildunterschrift aus dem alt-Text,
 * schlanke Kontrollleiste unter dem Bild (Pfeile + Balken-Indikatoren).
 * Pfeiltasten links/rechts funktionieren, wenn das Karussell fokussiert ist.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface CarouselImage {
  /** Importierte Bilddatei (ImageMetadata, wird optimiert) oder URL-String. */
  src: string | ImageMetadata;
  alt: string;
}

interface Props {
  images: CarouselImage[];
  label?: string;
}

const { images, label = "Bildergalerie" } = Astro.props;
---

{
  images.length > 0 && (
    <div class="docs-image-carousel" data-image-carousel aria-label={label} tabindex="0">
      <div class="docs-image-carousel__slides">
        {images.map((image, index) => (
          <figure class="docs-image-carousel__slide" data-carousel-slide hidden={index !== 0}>
            {typeof image.src === "string" ? (
              <img src={image.src} alt={image.alt} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
            ) : (
              <Image
                src={image.src}
                alt={image.alt}
                width={Math.min(1024, image.src.width)}
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            )}
            <figcaption class="docs-image-carousel__caption">{image.alt}</figcaption>
          </figure>
        ))}
      </div>

      {images.length > 1 && (
        <div class="docs-image-carousel__bar">
          <button
            type="button"
            class="btn btn-ghost btn-circle btn-sm"
            data-carousel-prev
            aria-label="Vorheriges Bild"
          >
            ❮
          </button>

          <div class="docs-image-carousel__indicators">
            {images.map((_, index) => (
              <button
                type="button"
                class:list={[
                  "docs-image-carousel__indicator",
                  { "docs-image-carousel__indicator--active": index === 0 },
                ]}
                data-carousel-dot
                data-carousel-slide-to={index}
                aria-label={`Bild ${index + 1} anzeigen`}
                aria-current={index === 0 ? "true" : "false"}
              />
            ))}
          </div>

          <button
            type="button"
            class="btn btn-ghost btn-circle btn-sm"
            data-carousel-next
            aria-label="Nächstes Bild"
          >
            ❯
          </button>
        </div>
      )}
    </div>
  )
}

<script>
  document.querySelectorAll("[data-image-carousel]").forEach((carousel) => {
    if (!(carousel instanceof HTMLElement) || carousel.dataset.carouselReady === "true") return;
    carousel.dataset.carouselReady = "true";

    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
    const indicators = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"));
    let activeIndex = 0;

    const showSlide = (requestedIndex: number) => {
      activeIndex = (requestedIndex + slides.length) % slides.length;

      slides.forEach((slide, index) => {
        slide.hidden = index !== activeIndex;
      });

      indicators.forEach((indicator, index) => {
        const isActive = index === activeIndex;
        indicator.classList.toggle("docs-image-carousel__indicator--active", isActive);
        indicator.setAttribute("aria-current", isActive ? "true" : "false");
      });
    };

    carousel.querySelector("[data-carousel-prev]")?.addEventListener("click", () => showSlide(activeIndex - 1));
    carousel.querySelector("[data-carousel-next]")?.addEventListener("click", () => showSlide(activeIndex + 1));
    indicators.forEach((indicator) => {
      indicator.addEventListener("click", () => showSlide(Number(indicator.dataset.carouselSlideTo)));
    });

    carousel.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") showSlide(activeIndex - 1);
      if (event.key === "ArrowRight") showSlide(activeIndex + 1);
    });
  });
</script>

<style>
  .docs-image-carousel {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    outline: none;
  }

  .docs-image-carousel:focus-visible {
    border-radius: var(--radius-md);
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  .docs-image-carousel__slide {
    margin: 0;
    animation: docs-image-carousel-in 260ms ease;
  }

  @keyframes docs-image-carousel-in {
    from {
      opacity: 0;
      transform: translateX(8px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .docs-image-carousel__slide img {
    display: block;
    max-height: 420px;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    margin-inline: auto;
    border-radius: var(--radius-md);
    box-shadow: 0 4px 24px color-mix(in oklab, var(--color-text) 14%, transparent);
  }

  .docs-image-carousel__caption {
    margin-top: var(--spacing-xs);
    text-align: center;
    font-size: 0.85em;
    color: var(--color-text-muted);
  }

  .docs-image-carousel__bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-xs);
  }

  .docs-image-carousel__indicators {
    display: flex;
    align-items: center;
    gap: var(--spacing-2xs);
  }

  .docs-image-carousel__indicator {
    width: 16px;
    height: 4px;
    padding: 0;
    border: none;
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--color-text) 25%, transparent);
    cursor: pointer;
    transition: width 200ms ease, background-color 200ms ease;
  }

  .docs-image-carousel__indicator:hover {
    background: color-mix(in oklab, var(--color-text) 45%, transparent);
  }

  .docs-image-carousel__indicator--active {
    width: 32px;
    background: var(--color-primary);
  }
</style>

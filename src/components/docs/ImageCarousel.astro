---
/**
 * Bildkarussell im "Minimal Clean"-Stil:
 * Freistehendes Bild mit weichem Schatten, Bildunterschrift aus dem alt-Text,
 * schlanke Kontrollleiste unter dem Bild (Pfeile + Balken-Indikatoren).
 * Pfeiltasten links/rechts funktionieren, wenn das Karussell fokussiert ist.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface CarouselImage {
  /** Importierte Bilddatei (ImageMetadata, wird optimiert) oder URL-String. */
  src: string | ImageMetadata;
  alt: string;
}

interface Props {
  images: CarouselImage[];
  label?: string;
}

const { images, label = "Bildergalerie" } = Astro.props;

/** Muss zu max-height von .docs-image-carousel__slide img passen. */
const MAX_DISPLAY_HEIGHT = 420;
const MAX_RENDER_WIDTH = 1024;

/**
 * Angezeigte Groesse eines Bildes vorberechnen (Breite auf 1024 begrenzt,
 * Hoehe per CSS auf 420px). Damit reserviert der Skeleton-Platzhalter exakt
 * den Platz des fertigen Bildes und das Layout springt beim Laden nicht.
 */
function displaySize(src: ImageMetadata) {
  let width = Math.min(MAX_RENDER_WIDTH, src.width);
  let height = src.height * (width / src.width);
  if (height > MAX_DISPLAY_HEIGHT) {
    width = width * (MAX_DISPLAY_HEIGHT / height);
    height = MAX_DISPLAY_HEIGHT;
  }
  return { width: Math.round(width), height: Math.round(height) };
}
---

{
  images.length > 0 && (
    <div class="docs-image-carousel" data-image-carousel aria-label={label} tabindex="0">
      <div class="docs-image-carousel__slides">
        {images.map((image, index) => {
          const size = typeof image.src === "string" ? null : displaySize(image.src);
          return (
            <figure class="docs-image-carousel__slide" data-carousel-slide hidden={index !== 0}>
              <div
                class="docs-image-carousel__media skeleton"
                style={size ? `--media-width: ${size.width}px; --media-aspect: ${size.width} / ${size.height};` : undefined}
                data-carousel-media
              >
                {typeof image.src === "string" ? (
                  <img src={image.src} alt={image.alt} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
                ) : (
                  <Image
                    src={image.src}
                    alt={image.alt}
                    width={Math.min(MAX_RENDER_WIDTH, image.src.width)}
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                )}
              </div>
              <figcaption class="docs-image-carousel__caption">{image.alt}</figcaption>
            </figure>
          );
        })}
      </div>

      {images.length > 1 && (
        <div class="docs-image-carousel__bar">
          <button
            type="button"
            class="btn btn-ghost btn-circle btn-sm"
            data-carousel-prev
            aria-label="Vorheriges Bild"
          >
            ❮
          </button>

          <div class="docs-image-carousel__indicators">
            {images.map((_, index) => (
              <button
                type="button"
                class:list={[
                  "docs-image-carousel__indicator",
                  { "docs-image-carousel__indicator--active": index === 0 },
                ]}
                data-carousel-dot
                data-carousel-slide-to={index}
                aria-label={`Bild ${index + 1} anzeigen`}
                aria-current={index === 0 ? "true" : "false"}
              />
            ))}
          </div>

          <button
            type="button"
            class="btn btn-ghost btn-circle btn-sm"
            data-carousel-next
            aria-label="Nächstes Bild"
          >
            ❯
          </button>
        </div>
      )}
    </div>
  )
}

<script>
  document.querySelectorAll("[data-image-carousel]").forEach((carousel) => {
    if (!(carousel instanceof HTMLElement) || carousel.dataset.carouselReady === "true") return;
    carousel.dataset.carouselReady = "true";

    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
    const indicators = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"));
    let activeIndex = 0;

    const showSlide = (requestedIndex: number) => {
      activeIndex = (requestedIndex + slides.length) % slides.length;

      slides.forEach((slide, index) => {
        slide.hidden = index !== activeIndex;
      });

      indicators.forEach((indicator, index) => {
        const isActive = index === activeIndex;
        indicator.classList.toggle("docs-image-carousel__indicator--active", isActive);
        indicator.setAttribute("aria-current", isActive ? "true" : "false");
      });
    };

    carousel.querySelector("[data-carousel-prev]")?.addEventListener("click", () => showSlide(activeIndex - 1));
    carousel.querySelector("[data-carousel-next]")?.addEventListener("click", () => showSlide(activeIndex + 1));
    indicators.forEach((indicator) => {
      indicator.addEventListener("click", () => showSlide(Number(indicator.dataset.carouselSlideTo)));
    });

    carousel.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") showSlide(activeIndex - 1);
      if (event.key === "ArrowRight") showSlide(activeIndex + 1);
    });

    // Skeleton-Platzhalter entfernen, sobald das jeweilige Bild geladen ist.
    carousel.querySelectorAll<HTMLElement>("[data-carousel-media]").forEach((media) => {
      const image = media.querySelector("img");
      const reveal = () => media.classList.remove("skeleton");

      if (!image || (image.complete && image.naturalWidth > 0)) {
        reveal();
        return;
      }
      image.addEventListener("load", reveal, { once: true });
      image.addEventListener("error", reveal, { once: true });
    });
  });
</script>

<style>
  .docs-image-carousel {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    outline: none;
  }

  .docs-image-carousel:focus-visible {
    border-radius: var(--radius-md);
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  .docs-image-carousel__slide {
    margin: 0;
    animation: docs-image-carousel-in 260ms ease;
  }

  @keyframes docs-image-carousel-in {
    from {
      opacity: 0;
      transform: translateX(8px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Platzhalter: reserviert NUR waehrend des Ladens die (vorberechnete)
     Bildgroesse, damit das Layout nicht springt. Nach dem Laden bestimmt
     wieder das Bild selbst die Groesse — kein Restabstand zur Caption.
     Fallback fuer URL-Bilder ohne bekannte Masse: 40rem breit, 3:2. */
  .docs-image-carousel__media {
    max-width: 100%;
    margin-inline: auto;
  }

  .docs-image-carousel__media.skeleton {
    width: var(--media-width, min(40rem, 100%));
    aspect-ratio: var(--media-aspect, 3 / 2);
    border-radius: var(--radius-md);
  }

  .docs-image-carousel__media.skeleton img {
    opacity: 0;
  }

  .docs-image-carousel__slide img {
    display: block;
    max-height: 420px; /* muss zu MAX_DISPLAY_HEIGHT im Frontmatter passen */
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    margin-inline: auto;
    border-radius: var(--radius-md);
    box-shadow: 0 4px 24px color-mix(in oklab, var(--color-text) 14%, transparent);
    transition: opacity 200ms ease;
  }

  .docs-image-carousel__caption {
    margin-top: var(--spacing-xs);
    text-align: center;
    font-size: 0.85em;
    color: var(--color-text-muted);
  }

  .docs-image-carousel__bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-xs);
  }

  .docs-image-carousel__indicators {
    display: flex;
    align-items: center;
    gap: var(--spacing-2xs);
  }

  .docs-image-carousel__indicator {
    width: 16px;
    height: 4px;
    padding: 0;
    border: none;
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--color-text) 25%, transparent);
    cursor: pointer;
    transition: width 200ms ease, background-color 200ms ease;
  }

  .docs-image-carousel__indicator:hover {
    background: color-mix(in oklab, var(--color-text) 45%, transparent);
  }

  .docs-image-carousel__indicator--active {
    width: 32px;
    background: var(--color-primary);
  }
</style>

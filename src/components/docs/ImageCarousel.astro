---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface CarouselImage {
  /** Importierte Bilddatei (ImageMetadata, wird optimiert) oder URL-String. */
  src: string | ImageMetadata;
  alt: string;
}

interface Props {
  images: CarouselImage[];
  label?: string;
}

const { images, label = "Bildergalerie" } = Astro.props;
---

{
  images.length > 0 && (
    <div class="docs-image-carousel" data-image-carousel aria-label={label}>
      <div class="docs-image-carousel__viewport">
        <div class="docs-image-carousel__slides">
          {images.map((image, index) => (
            <figure class="docs-image-carousel__slide" data-carousel-slide hidden={index !== 0}>
              {typeof image.src === "string" ? (
                <img src={image.src} alt={image.alt} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
              ) : (
                <Image
                  src={image.src}
                  alt={image.alt}
                  width={Math.min(1024, image.src.width)}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              )}
            </figure>
          ))}
        </div>

        {images.length > 1 && (
          <div class="docs-image-carousel__controls">
            <button type="button" class="btn btn-soft btn-primary docs-image-carousel__control" data-carousel-prev aria-label="Vorheriges Bild">
              ❮
            </button>
            <button type="button" class="btn btn-soft btn-primary docs-image-carousel__control" data-carousel-next aria-label="Nächstes Bild">
              ❯
            </button>
          </div>
        )}
        
        {images.length > 1 && (
          <div class="docs-image-carousel__dots">
            {images.map((_, index) => (
              <button
                type="button"
                class:list={[
                  "btn",
                  "btn-xs",
                  "btn-circle",
                  "docs-image-carousel__dot",
                  {
                    "btn-primary": index === 0,
                    "docs-image-carousel__dot--active": index === 0,
                  },
                ]}
                data-carousel-dot
                data-carousel-slide-to={index}
                aria-label={`Bild ${index + 1} anzeigen`}
                aria-current={index === 0 ? "true" : "false"}
              >
                
              </button>
            ))}
          </div>
        )}
      </div>
    </div>
  )
}

<script>
  document.querySelectorAll("[data-image-carousel]").forEach((carousel) => {
    if (carousel instanceof HTMLElement && carousel.dataset.carouselReady === "true") {
      return;
    }

    if (carousel instanceof HTMLElement) {
      carousel.dataset.carouselReady = "true";
    }

    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"));
    const previousButton = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const nextButton = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
    let activeIndex = 0;

    const showSlide = (requestedIndex: number) => {
      activeIndex = (requestedIndex + slides.length) % slides.length;

      slides.forEach((slide, index) => {
        slide.hidden = index !== activeIndex;
      });

      dots.forEach((dot, index) => {
        const isActive = index === activeIndex;
        dot.classList.toggle("btn-primary", isActive);
        dot.classList.toggle("docs-image-carousel__dot--active", isActive);
        dot.setAttribute("aria-current", isActive ? "true" : "false");
      });
    };

    previousButton?.addEventListener("click", () => showSlide(activeIndex - 1));
    nextButton?.addEventListener("click", () => showSlide(activeIndex + 1));

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        showSlide(Number(dot.dataset.carouselSlideTo));
      });
    });
  });
</script>

<style>
  .docs-image-carousel {
    position: relative;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }

  .docs-image-carousel__viewport {
    position: relative;
    max-width: 100%;
    overflow: hidden;

  }

  .docs-image-carousel__slides {
    max-width: 100%;
  }

  .docs-image-carousel__slide {
    margin: 0;
    
    max-width: 100%;
  }

  .docs-image-carousel__slide img {
    display: block;
    

  max-height: 420px;
  object-fit: contain;

    width: auto;
    max-width: 100%;
    height: auto;
  }

  .docs-image-carousel__controls {
    pointer-events: none;
    margin-left: 1rem;
    margin-right: 1rem;
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
  }

  .docs-image-carousel__control {
    pointer-events: auto;
  }

  .docs-image-carousel__dots {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    z-index: 2;
    display: flex;
    gap: 0.5rem;
    transform: translateX(-50%);
  }

  .docs-image-carousel__dot {
    transition:
      transform 160ms ease,
      opacity 160ms ease;
      transform: scale(0.8);
  }

  .docs-image-carousel__dot--active {
    transform: scale(1.2);
    margin-left: 0.3rem;
    margin-right: 0.3rem;
  }
</style>

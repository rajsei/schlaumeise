---
import { parseLineSelection } from "@plugins/code-block-meta.mjs";
import { getDictionary } from "@i18n";
import { getLocaleFromPathname } from "@i18n/routing";

interface Props {
  title?: string;
  code?: string;
  copy?: boolean;
  prompt?: string;
  showPrompt?: boolean;
  showLineNumbers?: boolean;
  highlightLines?: string | number[];
  highlightWords?: string[];
  class?: string;
}

const {
  title = "Terminal",
  code,
  copy = true,
  prompt = "$",
  showPrompt = false,
  showLineNumbers = false,
  highlightLines,
  highlightWords = [],
  class: className = "",
} = Astro.props;

const t = getDictionary(getLocaleFromPathname(Astro.url.pathname)).docs;

const slotHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";

const decodeEntities = (value: string) =>
  value
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&amp;/g, "&")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'");

const stripTags = (value: string) =>
  value
    .replace(/<br\s*\/?>/gi, "\n")
    .replace(/<\/p>\s*<p>/gi, "\n")
    .replace(/<[^>]+>/g, "");

const fromSlot = decodeEntities(stripTags(slotHtml));
const rawInput = code ?? fromSlot;
const normalizedCode = rawInput.replace(/\r\n/g, "\n").replace(/^\n+|\n+$/g, "");
const lines = normalizedCode ? normalizedCode.split("\n") : [""];

const lineHighlights = Array.isArray(highlightLines)
  ? [...new Set(highlightLines.filter((line) => Number.isInteger(line) && line > 0))].sort((a, b) => a - b)
  : parseLineSelection(highlightLines ?? "");

const escapedWords = highlightWords.filter(Boolean).map((word) => word.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));
const highlightRegex = escapedWords.length > 0 ? new RegExp(`(${escapedWords.join("|")})`, "g") : null;

const escapeHtml = (value: string) =>
  value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/\"/g, "&quot;")
    .replace(/'/g, "&#39;");

const renderedLines = lines.map((line) => {
  const escaped = escapeHtml(line);

  if (!highlightRegex) {
    return escaped;
  }

  return escaped.replace(highlightRegex, '<mark class="docs-terminal__word">$1</mark>');
});

const classes = ["docs-terminal", showLineNumbers ? "has-line-numbers" : "", className]
  .filter(Boolean)
  .join(" ");
---

<figure class={classes}>
  <figcaption class="docs-terminal__header">
    <span class="docs-terminal__title">{title}</span>
  </figcaption>

  <div
    class="docs-terminal__body"
    data-docs-copy-surface={copy ? "true" : undefined}
    data-copy-source={copy ? normalizedCode : undefined}
  >
    <pre class="docs-terminal__pre"><code>
      {
        renderedLines.map((line, index) => {
          const lineNumber = index + 1;
          const isHighlighted = lineHighlights.includes(lineNumber);
          return (
            <span
              class:list={["docs-terminal__line", isHighlighted && "is-highlighted"]}
              data-line={showLineNumbers ? lineNumber : undefined}
            >
              {showPrompt && <span class="docs-terminal__prompt" aria-hidden="true">{prompt}</span>}
              <span set:html={line}></span>
            </span>
          );
        })
      }
    </code></pre>

    {
      copy && (
        <button
          type="button"
          class="docs-code-block__copy docs-code-block__copy--terminal"
          data-docs-copy-button
          data-copy-label={t.copyCode}
          data-copied-label={t.copiedCode}
          data-copy-source={normalizedCode}
          aria-label={t.copyCode}
        >
          <span class="docs-code-block__copy-icon-wrap">
            <svg class="docs-code-block__copy-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M8 8H7.2C6.0799 8 5.51984 8 5.09202 8.21799C4.71569 8.40973 4.40973 8.71569 4.21799 9.09202C4 9.51984 4 10.0799 4 11.2V16.8C4 17.9201 4 18.4802 4.21799 18.908C4.40973 19.2843 4.71569 19.5903 5.09202 19.782C5.51984 20 6.0799 20 7.2 20H12.8C13.9201 20 14.4802 20 14.908 19.782C15.2843 19.5903 15.5903 19.2843 15.782 18.908C16 18.4802 16 17.9201 16 16.8V16M11.2 16H16.8C17.9201 16 18.4802 16 18.908 15.782C19.2843 15.5903 19.5903 15.2843 19.782 14.908C20 14.4802 20 13.9201 20 12.8V7.2C20 6.0799 20 5.51984 19.782 5.09202C19.5903 4.71569 19.2843 4.40973 18.908 4.21799C18.4802 4 17.9201 4 16.8 4H11.2C10.0799 4 9.51984 4 9.09202 4.21799C8.71569 4.40973 8.40973 4.71569 8.21799 5.09202C8 5.51984 8 6.07989 8 7.2V12.8C8 13.9201 8 14.4802 8.21799 14.908C8.40973 15.2843 8.71569 15.5903 9.09202 15.782C9.51984 16 10.0799 16 11.2 16Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <svg class="docs-code-block__copied-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 12.6111L8.92308 17.5L20 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="sr-only">{t.copyCode}</span>
        </button>
      )
    }
  </div>
</figure>

<script>
  import "@scripts/docs-code-copy";
</script>

<style>
  .docs-terminal {
    margin: var(--spacing-md) 0;
    border: 1px solid var(--docs-terminal-border);
    border-radius: var(--radius-md);
    background: var(--docs-terminal-bg);
    color: var(--docs-terminal-fg);
    overflow: hidden;
  }

  .docs-terminal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.25rem;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-bottom: 1px solid var(--docs-terminal-border);
    background: var(--docs-terminal-header-bg);
  }

  .docs-terminal__title {
    font-size: var(--font-size-xs);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--docs-terminal-muted);
  }

  .docs-terminal__body {
    position: relative;
  }

  /* Kopier-Affordanz: die gesamte Flaeche ist per Klick kopierbar (docs-code-copy.ts)
     -> Copy-Cursor. Direkt ueber dem Text bleibt der Text-Cursor zum Markieren. */
  .docs-terminal__body[data-docs-copy-surface] {
    cursor: copy;
  }

  .docs-terminal__body[data-docs-copy-surface] .docs-terminal__line > span:not(.docs-terminal__prompt) {
    cursor: text;
  }

  .docs-terminal__pre {
    margin: 0;
    padding: 0.95rem 1rem 0.95rem 1.2rem; /* bespoke: asymmetrisches Callout-Padding */
    overflow-x: auto;
    background: var(--docs-terminal-bg);
  }

  .docs-terminal__pre code {
    display: block;
    white-space: pre;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
  }

  .docs-terminal__line {
    display: block;
  }

  .docs-terminal.has-line-numbers .docs-terminal__line {
    padding-left: 2.25rem; /* bespoke: Zeilennummern-Gutter */
    position: relative;
  }

  .docs-terminal.has-line-numbers .docs-terminal__line::before {
    content: attr(data-line);
    position: absolute;
    left: 0;
    width: 1.7rem;
    text-align: right;
    color: var(--docs-terminal-line-number);
    user-select: none;
  }

  .docs-terminal__line.is-highlighted {
    background: color-mix(in srgb, var(--docs-terminal-highlight-line), transparent 78%);
  }

  .docs-terminal__prompt {
    color: var(--docs-terminal-prompt);
    margin-right: var(--spacing-xs);
    user-select: none;
  }

  .docs-terminal__word {
    background: color-mix(in srgb, var(--docs-terminal-word-bg), transparent 70%);
    color: var(--docs-terminal-word-fg);
    border-radius: var(--radius-xs);
    padding: 0 var(--spacing-3xs);
  }

  .docs-code-block__copy--terminal {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 1;
    border: 1px solid var(--docs-terminal-copy-border);
    border-radius: var(--radius-sm);
    background: var(--docs-terminal-copy-bg);
    color: var(--docs-terminal-fg);
    width: 2rem;
    height: 2rem;
    display: inline-grid;
    place-items: center;
    padding: 0;
    cursor: copy;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-2px);
    transition: border-color 120ms ease, transform 120ms ease, opacity 120ms ease;
  }

  .docs-terminal__body:hover .docs-code-block__copy--terminal,
  .docs-terminal__body:focus-within .docs-code-block__copy--terminal {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .docs-code-block__copy--terminal:hover,
  .docs-code-block__copy--terminal:focus-visible {
    border-color: var(--docs-terminal-prompt);
    transform: translateY(-1px);
  }

  .docs-code-block__copy--terminal:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--docs-terminal-prompt), transparent 45%);
    outline-offset: 1px;
  }

  @media (max-width: 640px) {
    .docs-terminal__pre {
      padding: var(--spacing-sm);
      /* Rechter Freiraum, damit der dauerhaft sichtbare Button keine Schrift verdeckt. */
      padding-right: 3.1rem; /* bespoke: an feste Button-Groesse (2.25rem) gekoppelt, darf nicht mit --spacing-* schrumpfen */
    }

    .docs-terminal__pre code {
      font-size: var(--font-size-sm);
    }
  }

  /* Scroll-Affordanz: rechter Kanten-Schatten, wenn das Terminal horizontal scrollbar
     ist und noch nicht am Ende (data-xscroll via docs-scroll-shadow.ts). */
  .docs-terminal__body[data-xscroll]::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--spacing-lg);
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms ease;
    background: linear-gradient(to left, var(--color-gray-transparent), transparent);
  }

  .docs-terminal__body[data-xscroll="more"]::after {
    opacity: 1;
  }

  /* Touch-/Schmal-Screens: Copy-Button dauerhaft sichtbar. Tap-Target ~36px: gross genug
     zum Tippen, aber kompakt genug, dass er auf kurzen Terminals nicht unten ueberlaeuft.
     Die gesamte Flaeche ist ohnehin antippbar zum Kopieren. */
  @media (pointer: coarse), (max-width: 640px) {
    .docs-code-block__copy--terminal {
      opacity: 1;
      pointer-events: auto;
      transform: none;
      top: 0.4rem;
      right: 0.4rem;
      width: 2.25rem;
      height: 2.25rem;
    }
  }
</style>

---
/**
 * NavBadge — kleines Hinweis-Badge hinter einem Sidebar-Eintrag
 * (Topic-Button, Gruppen-Titel, Link), z. B. „Neu" oder „Archiv".
 *
 * Badges werden in `src/config/docs-navigation.ts` (`badge: "new"`) bzw. im
 * Frontmatter einer Seite (`sidebar.badge`) gesetzt; der Resolver liefert
 * Variante + lokalisiertes Label. Die Komponente rendert nur.
 *
 * Steht rechtsbündig im Eintrag (`margin-inline-start: auto`) und ist Teil
 * des zugänglichen Namens („Workshops Archiv") — deshalb das führende
 * Leerzeichen an der Aufrufstelle.
 *
 * Props:
 *   badge — ResolvedNavBadge ({ variant, label }) aus lib/docs-navigation
 *
 * Beispiel:
 *   {item.badge && <NavBadge badge={item.badge} />}
 */
import type { NavBadgeVariant } from "@config/docs-navigation";
import type { ResolvedNavBadge } from "@lib/docs-navigation";

interface Props {
  badge: ResolvedNavBadge;
}

const { badge } = Astro.props;

const variantClasses: Record<NavBadgeVariant, string> = {
  new: "badge-secondary",
  archive: "badge-ghost",
};
---

<span class:list={["nav-badge badge badge-sm", variantClasses[badge.variant]]}>
  {badge.label}
</span>

<style>
  .nav-badge {
    flex-shrink: 0;
    justify-self: end;
    margin-inline-start: auto;
    font-weight: var(--font-weight-semibold);
  }
</style>

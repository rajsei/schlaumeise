---
import type { ResolvedNavItem } from "../../lib/docs-navigation";

interface Props {
  items: ResolvedNavItem[];
  nested?: boolean;
}

const { items, nested = false } = Astro.props;
---

<ul class:list={["menu menu-md", nested ? "docs-nav__subitems" : "docs-nav__menu"]}>
  {
    items.map((item) => {
      if (item.type === "link") {
        return (
          <li>
            <a
              href={item.href}
              class:list={[
                "docs-nav__link",
                item.active && "menu-active is-active",
                item.emphasis && "docs-nav__top-level",
              ]}
              aria-current={item.active ? "page" : undefined}
              {...(item.attrs ?? {})}
            >
              {item.label}
            </a>
          </li>
        );
      }

      return (
        <li>
          <details
            class:list={[
              "docs-nav__group",
              item.emphasis && "docs-nav__top-level_group",
            ]}
            open={item.expanded}
          >
            <summary class="docs-nav__group_label summary-btn">{item.label}</summary>
            {
              item.overview && (
                <a
                  href={item.overview.href}
                  class:list={[
                    "docs-nav__overview btn btn-m overview-btn",
                    "justify-start w-full h-auto min-h-0",
                    "py-2 px-3 mt-1 text-left normal-case",
                    item.overview.active && "btn-active menu-active is-active",
                  ]}
                  aria-current={item.overview.active ? "page" : undefined}
                  {...(item.overview.attrs ?? {})}
                >
                  {item.overview.label}
                </a>
              )
            }
            <Astro.self items={item.items} nested />
          </details>
        </li>
      );
    })
  }
</ul>

<style>
  .overview-btn {
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    margin-top: 0px;
  }
  .summary-btn {
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
  }

  :global(:root[data-theme="light"] .docs-nav__overview.is-active),
  :global(:root[data-theme="light"] .docs-nav__overview.is-active:hover),
  :global(:root[data-theme="light"] .docs-nav__overview.is-active:focus-visible) {
    background: var(--color-base-content);
    color: var(--color-base-100);
  }

  :global(:root[data-theme="dark"] .docs-nav__link.is-active),
  :global(:root[data-theme="dark"] .docs-nav__overview.is-active) {
    /*background: var(--color-accent-high);
    color: var(--color-base-100);*/
    background: var(--color-base-content);
    color: var(--color-base-100);
  }

  :global(:root[data-theme="dark"] .docs-nav__link.is-active:hover),
  :global(:root[data-theme="dark"] .docs-nav__link.is-active:focus-visible),
  :global(:root[data-theme="dark"] .docs-nav__overview.is-active:hover),
  :global(:root[data-theme="dark"] .docs-nav__overview.is-active:focus-visible) {
    background: var(--color-accent-high);
    color: var(--color-base-100);
  }
</style>

---
import euFundingLogo from "@assets/EFRE-ESF_LO_Kombination_EU-Logo_SachsenSignet-klassisch_H_RGB.png";
import type { BrandConfig } from "@config/site.config";
import { formatMessage, type Dictionary } from "@i18n";
import type { Locale } from "@i18n/config";
import { buildLocalizedUrl } from "@i18n/routing";

interface Props {
  locale: Locale;
  dictionary: Dictionary;
  brand: BrandConfig;
}

const { locale, dictionary, brand } = Astro.props;
const homeHref = buildLocalizedUrl(locale, "/");
const imprintHref = buildLocalizedUrl(locale, "/impressum/");
const brandAria = formatMessage(dictionary.a11y.brandHome, {
  brand: brand.name,
});
---

<footer
  class="footer md:footer-horizontal bg-base-300 text-base-content border-base-300 items-center border-t px-4 py-4 md:px-10"
>
  <div class="brand-block">
    <a class="brand" href={homeHref} aria-label={brandAria}>
      <img
        src={brand.logo.src}
        alt=""
        width="40"
        height="40"
        loading="lazy"
        decoding="async"
      />
      <span class="brand-name text-xl">{brand.name}</span>
    </a>
  </div>

  <nav class="footer-links" aria-label={dictionary.footer.navLabel}>
    <a class="link link-hover" href={imprintHref}>{dictionary.footer.imprint}</a>
  </nav>

  <div class="funding-block">
    <img
      src={euFundingLogo.src}
      alt={dictionary.footer.fundingAlt}
      width={euFundingLogo.width}
      height={euFundingLogo.height}
      class="funding-logo"
      loading="lazy"
      decoding="async"
    />
  </div>
</footer>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-text-strong);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .footer-links {
    display: flex;
    gap: var(--spacing-md);
  }

  .funding-logo {
    height: 3.5rem;
    width: auto;
    max-width: 100%;
    background: var(--color-fixed-white);
    border-radius: var(--radius-sm);
    padding: var(--spacing-2xs) var(--spacing-xs);
  }

  /* Sehr kleine Screens: Logo nach Breite statt Hoehe skalieren, damit es
     nie ueber den Viewport hinauslaeuft (Seitenverhaeltnis bleibt erhalten). */
  @media (max-width: 480px) {
    .funding-logo {
      height: auto;
      width: 100%;
      max-width: 18rem;
    }
  }
</style>

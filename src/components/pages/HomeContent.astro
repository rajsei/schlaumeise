---
import { getBrandConfig } from "../../config/site.config";
import { formatMessage, getDictionary } from "../../i18n";
import type { Locale } from "../../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const brand = getBrandConfig(locale);
---

<section class="hero bg-base-200 min-h-[50vh]">
  <div class="hero-content text-center">
    <div class="max-w-xl">
      <h1 class="text-5xl font-bold">{formatMessage(dictionary.home.title, { brand: brand.name })}</h1>
      <p class="py-6">{dictionary.home.intro}</p>
    </div>
  </div>
</section>

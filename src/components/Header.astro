---
import ThemeController from "./ui-elements/ThemeController.astro";
import DropdownNavItem from "./ui-elements/DropdownNavItem.astro";
import type { BrandConfig } from "../config/site.config";
import { formatMessage, type Dictionary } from "../i18n";
import type { Locale } from "../i18n/config";
import { buildLocalizedUrl } from "../i18n/routing";

interface Props {
  locale: Locale;
  dictionary: Dictionary;
  brand: BrandConfig;
  languageSwitchHref: string;
}

const { locale, dictionary, brand, languageSwitchHref } = Astro.props;

const homeHref = buildLocalizedUrl(locale, "/");
const homeLabel = formatMessage(dictionary.a11y.brandHome, {
  brand: brand.name,
});
const currentPathname = Astro.url.pathname;

const primaryNavItems = [
  {
    href: homeHref,
    label: dictionary.nav.home,
  },
];

const dropdownContent = [
  {
    href: buildLocalizedUrl(locale, "/services"),
    label: dictionary.nav.services,
  },
  {
    href: buildLocalizedUrl(locale, "/contact"),
    label: dictionary.nav.contact,
  },
];

function normalizePathname(path: string): string {
  const pathname = new URL(path, Astro.url).pathname.replace(/\/+$/, "");
  return pathname === "" ? "/" : pathname;
}

function isActivePath(path: string): boolean {
  return normalizePathname(path) === normalizePathname(currentPathname);
}

const isParentActive = dropdownContent.some((entry) =>
  isActivePath(entry.href),
);

function navLinkClass(href: string, extra: string[] = []): string {
  return ["button-nav", ...extra, isActivePath(href) && "is-active"]
    .filter(Boolean)
    .join(" ");
}
---

<div class="navbar bg-base-100 shadow-sm">
  <div class="navbar-start">
    <button
      type="button"
      class="btn btn-ghost mr-2 docs-toggle-btn"
      data-docs-sidebar-toggle
      aria-controls="docs-sidebar global-docs-sidebar"
      aria-expanded="false"
      aria-label={dictionary.docs.toggleNav}
    >
      <span class="docs-toggle-icon" aria-hidden="true">
        <span class="docs-toggle-line"></span>
        <span class="docs-toggle-line"></span>
        <span class="docs-toggle-line"></span>
      </span>
    </button>
    <div class="dropdown">
      <!-- <div tabindex="0" role="button" class="btn btn-outline lg:hidden">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h8m-8 6h16"></path>
        </svg>
      </div> -->
      <ul
        tabindex="-1"
        class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow"
      >
        {
          primaryNavItems.map((item) => (
            <li>
              <a class={navLinkClass(item.href)} href={item.href}>
                <span class="global-nav__link_text">{item.label}</span>
              </a>
            </li>
          ))
        }
        <li class="dropdown-mobile-group">
          <span class="dropdown-mobile-label">{dictionary.nav.parent}</span>
          <ul class="dropdown-mobile-list">
            {
              dropdownContent.map((entry) => (
                <li>
                  <a
                    class={navLinkClass(entry.href, ["dropdown-item"])}
                    href={entry.href}
                    role="menuitem"
                  >
                    <span class="global-nav__link_text">{entry.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        <li>
          <a
            class={navLinkClass(languageSwitchHref)}
            href={languageSwitchHref}
            aria-label={dictionary.a11y.switchLanguage}
          >
            <span class="global-nav__link_text">{dictionary.nav.switchTo}</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="btn btn-link text-xl">
      <a class="brand" href={homeHref} aria-label={homeLabel}>
        <img
          src={brand.logo.src}
          alt=""
          class="w-9 h-9"
          loading="lazy"
          decoding="async"
        />
        <span class="text-xl">{brand.name}</span>
      </a>
    </div>
  </div>

  <div class="navbar-center hidden lg:flex">
    <ul class="menu-horizontal px-1 nav-list" role="menubar">
      {
        primaryNavItems.map((item) => (
          <li>
            <a class={navLinkClass(item.href)} href={item.href}>
              <span class="global-nav__link_text">{item.label}</span>
            </a>
          </li>
        ))
      }
      <li>
        <DropdownNavItem
          label={dictionary.nav.parent}
          isActive={isParentActive}
        >
          {
            dropdownContent.map((entry) => (
              <a
                class={navLinkClass(entry.href, ["dropdown-item"])}
                href={entry.href}
                role="menuitem"
              >
                <span class="global-nav__link_text">{entry.label}</span>
              </a>
            ))
          }
        </DropdownNavItem>
      </li>
    </ul>
  </div>
  <div class="navbar-end">
    <a
      class={"button-languageSwitch btn btn-ghost"}
      href={languageSwitchHref}
      aria-label={dictionary.a11y.switchLanguage}
    >
      <span class="global-nav__link_text">{dictionary.nav.switchTo}</span>
    </a>
    <ThemeController />
  </div>
</div>

<script>
  const DOCS_TOGGLE_EVENT = "docs-sidebar:toggle";
  const toggleButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-docs-sidebar-toggle]",
  );

  for (const button of toggleButtons) {
    button.addEventListener("click", () => {
      document.dispatchEvent(new CustomEvent(DOCS_TOGGLE_EVENT));
    });
  }
</script>

<style>
  :global(.button-nav) {
    display: inline-flex;

    text-decoration: none;
    gap: 0.25rem;
    padding: 0.38rem 0.8rem;
    border-radius: 999px;

    font-weight: 600;
    font-size: 0.95rem;

    color: var(--color-text);
    transition:
      color 150ms ease,
      background 150ms ease;
  }

  :global(.button-nav:hover),
  :global(.button-nav:focus-visible) {
    color: var(--color-white);
    background: color-mix(in srgb, var(--color-accent), transparent 70%);
  }

  :global(.button-nav.is-active) {
    color: var(--color-white);
    background: var(--color-accent-low);
  }

  :global(.global-nav__link_text) {
    display: inline-flex;
    align-items: baseline;
  }

  .button-languageSwitch {
    display: inline-flex;

    text-decoration: none;
    gap: 0.25rem;
    padding: 0.38rem 0.8rem;
    border-radius: 999px;

    font-weight: 600;
    font-size: 0.95rem;

    color: var(--color-text);
    transition:
      color 150ms ease,
      background 150ms ease;
  }

  .dropdown-mobile-group {
    padding: 0.2rem 0.3rem 0.4rem;
  }

  .dropdown-mobile-label {
    display: block;
    padding: 0.45rem 0.6rem 0.2rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    opacity: 0.8;
  }

  .dropdown-mobile-list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-left: 0.3rem;
  }

  .nav-list {
    align-items: center;
    gap: 0.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-white);
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .navbar-start > .btn-link,
  .navbar-start > .btn-link:hover,
  .navbar-start > .btn-link:focus-visible {
    text-decoration: none;
  }

  .docs-toggle-btn {
    min-width: 2.6rem;
  }

  .docs-toggle-icon {
    width: 1.15rem;
    height: 1.15rem;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.18rem;
  }

  .docs-toggle-line {
    width: 100%;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .docs-toggle-btn.is-open .docs-toggle-line:nth-child(1) {
    transform: translateY(0.31rem) rotate(45deg);
  }

  .docs-toggle-btn.is-open .docs-toggle-line:nth-child(2) {
    opacity: 0;
  }

  .docs-toggle-btn.is-open .docs-toggle-line:nth-child(3) {
    transform: translateY(-0.31rem) rotate(-45deg);
  }
</style>

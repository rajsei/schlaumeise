---
/**
 * NotFoundCard — Inhalt der 404-Seite (Logo, Text, Wegweiser-Links), vollstaendig
 * ueber das `locale`-Prop lokalisiert. Wird von beiden echten 404-Seiten genutzt
 * (src/pages/404.astro = de, src/pages/en/404.astro = en), damit Markup und Stil nur
 * an EINER Stelle leben. Alle Links via buildLocalizedUrl — nie hart gebaut.
 *
 * Beispiel: <NotFoundCard locale="de" />
 */
import { getBrandConfig } from "@config/site.config";
import { getDictionary } from "@i18n";
import { buildLocalizedUrl } from "@i18n/routing";
import type { Locale } from "@i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).notFound;
const brand = getBrandConfig(locale);
const homeHref = buildLocalizedUrl(locale, "/");

// Wegweiser bewusst pro Sprache: project01 existiert nur auf Deutsch; die EN-Seite
// verweist stattdessen auf Bestandsinhalte, damit kein Link der 404 erneut ins Leere
// fuehrt. Beide Ziele existieren in der jeweiligen Sprache.
const secondaryLinks =
  locale === "de"
    ? [
        { label: t.linkProject, href: buildLocalizedUrl("de", "/projects/project01/") },
        { label: t.linkKnowledge, href: buildLocalizedUrl("de", "/knowledge/birds/") },
      ]
    : [
        { label: t.linkKnowledge, href: buildLocalizedUrl("en", "/knowledge/birds/") },
        { label: t.linkGlossary, href: buildLocalizedUrl("en", "/glossary/os/") },
      ];
---

<section class="flex min-h-[60vh] justify-center bg-base-200 px-4 py-12 md:py-20">
  <div
    class="mx-auto w-full max-w-md self-start rounded-box border border-base-300 bg-base-100 px-6 py-8 text-center shadow-sm md:px-8 md:py-10"
  >
    <img
      src={brand.logo.src}
      alt={t.logoAlt}
      width="80"
      height="80"
      class="mx-auto mb-4 h-20 w-20"
      loading="eager"
      decoding="async"
    />

    <span class="text-xs font-semibold uppercase tracking-wider text-base-content/60">{t.eyebrow}</span>

    <h1 class="mt-2 text-2xl font-bold leading-tight text-base-content">{t.title}</h1>

    <p class="mx-auto mt-3 max-w-sm text-sm leading-relaxed text-base-content/70">{t.description}</p>

    <div class="mt-7 flex flex-col items-center gap-3">
      <a class="btn btn-primary w-full max-w-xs gap-2" href={homeHref}>
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 11.5 12 4l9 7.5"></path>
          <path d="M5 10v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-9"></path>
        </svg>
        <span>{t.home}</span>
      </a>

      <div class="flex w-full max-w-xs gap-2">
        {
          secondaryLinks.map((link) => (
            <a class="btn btn-outline btn-sm flex-1" href={link.href}>
              {link.label}
            </a>
          ))
        }
      </div>
    </div>

    <p class="mt-7 border-t border-base-300 pt-4 text-xs leading-relaxed text-base-content/60">{t.note}</p>
  </div>
</section>

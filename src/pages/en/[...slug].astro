---
import { getCollection, render, type CollectionEntry } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import { resolveDocsNavigation } from "../../lib/docs/navigation";
import { getDictionary } from "../../i18n";

export async function getStaticPaths() {
  const docs = await getCollection("docs", ({ id }) => id.startsWith("en/"));

  return docs
    .map((entry) => {
      const slug = entry.id
        .slice("en/".length)
        .replace(/\.(md|mdx)$/i, "")
        .replace(/\/index$/i, "")
        .replace(/^\/+|\/+$/g, "");

      if (!slug) {
        return null;
      }

      return {
        params: { slug },
        props: { entry },
      };
    })
    .filter(Boolean);
}

interface Props {
  entry: CollectionEntry<"docs">;
}

const { entry } = Astro.props;
const locale = "en" as const;
const dictionary = getDictionary(locale);
const allDocs = await getCollection("docs");
const { Content, headings } = await render(entry);

const navigation = resolveDocsNavigation({
  locale,
  currentPathname: Astro.url.pathname,
  docs: allDocs,
  currentTopicId: entry.data.topicId,
});

const showSidebarDefault =
  entry.data.showSidebar ??
  (typeof entry.data.sidebar === "boolean" ? entry.data.sidebar : true);
---

<MainLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  showSidebarToggle={true}
>
  <DocsLayout
    title={entry.data.title}
    description={entry.data.description}
    headings={headings}
    navigation={navigation}
    showSidebarDefault={showSidebarDefault}
    labels={{
      navigation: dictionary.docs.navigation,
      topics: dictionary.docs.topics,
      global: dictionary.docs.global,
      closeSidebar: dictionary.docs.closeSidebar,
      tableOfContents: dictionary.docs.tableOfContents,
    }}
  >
    <Content />
  </DocsLayout>
</MainLayout>

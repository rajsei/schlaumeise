---
import smartfinchFull from "../../assets/SmartfinchFull.svg";
import { buildLocalizedUrl } from "../../i18n/routing";
import MainLayout from "../../layouts/MainLayout.astro";

const locale = "en" as const;

const hero = {
  tagline:
    "Smartfinch is an interactive learning platform that uses AI and projects centered on native birds to teach children and teens about nature, the environment, computer science, and acoustics.",
  image: {
    file: smartfinchFull,
  },
  actions: [
    {
      text: "Our First Project",
      link: "./projects/project01/",
      icon: "right-arrow",
    },
  ],
};

---

<MainLayout locale={locale} title="smartfinch">
  <section class="hero bg-base-200 py-8 md:py-16">
    <div class="hero-content w-full max-w-6xl flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-10">
      <div class="w-full max-w-[42rem] text-left">
        <h1 class="text-3xl font-bold leading-tight md:text-5xl">Smartfinch</h1>
        <p class="mt-4 text-base leading-relaxed md:mt-6 md:text-lg">{hero.tagline}</p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row md:mt-8">
          {
            hero.actions.map((action) => (
              <a class="btn btn-primary btn-lg w-full gap-2 sm:w-auto" href={action.link}>
                <span>{action.text}</span>
                {action.icon === "right-arrow" && <span aria-hidden="true">{"\u2192"}</span>}
              </a>
            ))
          }
        </div>
      </div>

      <div class="w-full max-w-[28rem] lg:max-w-[32rem]">
        <img
          src={hero.image.file.src}
          alt="Smartfinch Logo"
          class="h-auto w-full drop-shadow-md"
          loading="eager"
        />
      </div>
    </div>
  </section>
</MainLayout>

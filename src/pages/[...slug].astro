---
import DocsLayout from "@layouts/DocsLayout.astro";
import Steps from "@components/docs/Steps.astro";
import LinkCard from "@components/docs/LinkCard.astro";
import Code from "@components/docs/Code.astro";
import CodeBlock from "@components/docs/CodeBlock.astro";
import Terminal from "@components/docs/Terminal.astro";
import Term from "@components/docs/Term.astro";

import { render } from "astro:content";
import { defaultLocale } from "@i18n/config";
import {
  createSlugParam,
  getDefaultLocaleDocsEntries,
} from "@lib/docs-content";
import type { DocsEntry } from "@types/docs";

interface Props {
  entry: DocsEntry;
  entries: DocsEntry[];
}

export async function getStaticPaths() {
  const entries = await getDefaultLocaleDocsEntries();

  return entries.map((entry) => ({
    params: { slug: createSlugParam(entry) },
    props: { entry, entries },
  }));
}

const { entry, entries } = Astro.props;
const { Content, headings } = await render(entry);
const mdxComponents = { Steps, LinkCard, Code, CodeBlock, Terminal, Term };
---

<DocsLayout locale={defaultLocale} entry={entry} entries={entries} headings={headings}>
  <Content components={mdxComponents} />
</DocsLayout>

---
import type { MarkdownHeading } from "astro";
import "@styles/docs.css";
import Sidebar from "@components/ui-elements/Sidebar.astro";
import DocsTOC from "@components/docs/DocsTOC.astro";
import DocsPagination from "@components/docs/DocsPagination.astro";
import MdxInterpreter from "@components/docs/MdxInterpreter.astro";
import ProjectMeta from "@components/docs/ProjectMeta.astro";
import ZoomableDocsImages from "@components/docs/ZoomableDocsImages.astro";

import MainLayout from "./MainLayout.astro";
import type { Locale } from "@i18n/config";
import { formatMessage, getDictionary } from "@i18n";
import type { DocsEntry } from "@types/docs";
import { resolveDocsPagination } from "@lib/docs-navigation";

interface Props {
  locale: Locale;
  entry: DocsEntry;
  entries: DocsEntry[];
  headings: MarkdownHeading[];
}

const { locale, entry, entries, headings } = Astro.props;
const dictionary = getDictionary(locale);
const desktopMenuOpen = entry.data.menu !== false;
const visibleHeadingCount = headings.filter((heading) => heading.depth <= 4).length;
const hasVisibleHeadings = visibleHeadingCount > 0;
const showContentToc = entry.data.content !== false && hasVisibleHeadings;
const tocSectionCountLabel =
  visibleHeadingCount === 1
    ? dictionary.docs.tocSectionCountOne
    : formatMessage(dictionary.docs.tocSectionCount, {
        count: String(visibleHeadingCount),
      });
const pagination = resolveDocsPagination({
  locale,
  currentPathname: Astro.url.pathname,
  docsEntries: entries,
  currentEntry: entry,
  prevFallbackLabel: dictionary.docs.prevLabel,
  nextFallbackLabel: dictionary.docs.nextLabel,
});
---

<MainLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
>
  <section
    class="docs-shell drawer lg:drawer-open"
    data-docs-shell
    data-desktop-open={desktopMenuOpen ? "true" : "false"}
    data-mobile-open="false"
  >
    <input
      id="docs-sidebar-drawer"
      type="checkbox"
      class="drawer-toggle"
      data-docs-sidebar-input
    />

    <div class="drawer-content">
      <div class="docs-content-layout" data-show-content-toc={showContentToc ? "true" : "false"}>
        <div class="docs-main">
          <article class="docs-article">
            <header class="docs-article__header">
              <h1>{entry.data.title}</h1>
              {entry.data.description && <p>{entry.data.description}</p>}
            </header>

            {entry.data.project && <ProjectMeta locale={locale} meta={entry.data.project} />}

            {
              showContentToc && (
                <details class="docs-toc-mobile xl:hidden">
                  <summary>
                    <span class="docs-toc-mobile__icon" aria-hidden="true">
                      <svg
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        width="18"
                        height="18"
                      >
                        <path
                          d="M9 6h11M9 12h11M9 18h11M5 6v.01M5 12v.01M5 18v.01"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                    <span class="docs-toc-mobile__title">{dictionary.docs.tocHeading}</span>
                    <span class="docs-toc-mobile__count">{tocSectionCountLabel}</span>
                    <span class="docs-toc-mobile__chevron" aria-hidden="true">
                      <svg
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        width="16"
                        height="16"
                      >
                        <path
                          d="M6 9l6 6 6-6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                  </summary>
                  <div class="docs-toc-mobile__body">
                    <DocsTOC locale={locale} headings={headings} showHeading={false} />
                  </div>
                </details>
              )
            }

            <div class="docs-article__body">
              <MdxInterpreter>
                <slot />
              </MdxInterpreter>
              <ZoomableDocsImages />
              
            </div>

            <DocsPagination
              ariaLabel={dictionary.docs.paginationLabel}
              prevLabel={dictionary.docs.prevLabel}
              nextLabel={dictionary.docs.nextLabel}
              prev={pagination.prev}
              next={pagination.next}
            />
          </article>
        </div>

        {
          showContentToc && (
            <aside class="docs-toc-rail">
              <div class="docs-toc-rail__inner">
                <DocsTOC locale={locale} headings={headings} />
              </div>
            </aside>
          )
        }
      </div>
    </div>

    <aside
      id="docs-sidebar"
      class="docs-sidebar drawer-side"
      data-docs-sidebar
      aria-label={dictionary.docs.navLabel}
    >
      <label
        for="docs-sidebar-drawer"
        aria-label={dictionary.docs.closeNav}
        class="drawer-overlay lg:hidden"
      />

      <div class="docs-sidebar__inner">
        <Sidebar locale={locale} entries={entries} currentPathname={Astro.url.pathname} />
      </div>
    </aside>
  </section>

  <script>
    import { initDocsDrawer } from "@scripts/docs-drawer";

    initDocsDrawer({
      shellSelector: "[data-docs-shell]",
      sidebarSelector: "[data-docs-sidebar]",
      inputSelector: "[data-docs-sidebar-input]",
      toggleSelector: "[data-docs-sidebar-toggle]",
      desktopBreakpoint: "(min-width: 1024px)",
      missingInputMessage: "Missing docs sidebar drawer input",
    });
  </script>
</MainLayout>

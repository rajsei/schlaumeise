---
import "@styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import MenuDrawer from "@components/MenuDrawer.astro";
import { getBrandConfig, siteConfig } from "@config/site.config";
import { getDictionary } from "@i18n";
import { defaultLocale, type Locale } from "@i18n/config";
import { findDocEntryBySlug, getDocsEntriesForLocale } from "@lib/docs-content";
import {
  getLocaleFromPathname,
  stripLocaleFromPathname,
  switchLocalePath,
  withBase,
} from "@i18n/routing";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const {
  title = getBrandConfig(getLocaleFromPathname(Astro.url.pathname)).name,
  description = "",
  locale: localeProp,
} = Astro.props;

const locale = localeProp ?? getLocaleFromPathname(Astro.url.pathname);
const dictionary = getDictionary(locale);
const brand = getBrandConfig(locale);
const docsEntries = await getDocsEntriesForLocale(locale);
const pathWithoutLocale = stripLocaleFromPathname(Astro.url.pathname);
const isDocsPage =
  pathWithoutLocale === "/guides" ||
  pathWithoutLocale.startsWith("/guides/") ||
  pathWithoutLocale === "/reference" ||
  pathWithoutLocale.startsWith("/reference/");

const alternateLocale: Locale = locale === defaultLocale ? "en" : defaultLocale;

/* Sprachumschalter nur anzeigen, wenn die Zielseite existiert (kein EN-404).
   Docs-Seiten: Eintrag mit gleichem Doc-Pfad muss im Alternativ-Locale vorhanden sein.
   Nicht-Docs-Seiten (Home, 404) existieren in beiden Sprachen. */
const currentDocEntry = findDocEntryBySlug(docsEntries, pathWithoutLocale);
const hasTranslation = currentDocEntry
  ? findDocEntryBySlug(
      await getDocsEntriesForLocale(alternateLocale),
      pathWithoutLocale,
    ) !== null
  : true;
const languageSwitchHref = hasTranslation
  ? withBase(switchLocalePath(Astro.url.pathname, alternateLocale))
  : null;
---

<!doctype html>
<html lang={locale} data-theme={siteConfig.defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      /* Setzt Theme VOR dem ersten Paint (kein Aufblitzen).
         Speicherformat "schlaumeise:theme:v1": { mode: "light"|"dark", contrast: "normal"|"high" }.
         Drei Attribute am <html>: data-mode + data-contrast (eigene Selektoren) und das
         zusammengesetzte data-theme (light|dark|light-contrast|dark-contrast) fuer daisyUI.
         Praezedenz: gespeichert -> sonst prefers-contrast: more / prefers-color-scheme. */
      (function () {
        var mode = null, contrast = null;
        try {
          var stored = JSON.parse(localStorage.getItem("schlaumeise:theme:v1") || "null");
          if (stored) {
            if (stored.mode === "light" || stored.mode === "dark") mode = stored.mode;
            if (stored.contrast === "normal" || stored.contrast === "high") contrast = stored.contrast;
          }
          if (!mode) {
            var legacy = localStorage.getItem("theme");
            if (legacy === "light" || legacy === "dark") mode = legacy;
          }
        } catch (e) {
          /* localStorage nicht verfügbar: Systempräferenz nutzen */
        }
        var mm = window.matchMedia;
        if (!mode) mode = mm && mm("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        if (!contrast) contrast = mm && mm("(prefers-contrast: more)").matches ? "high" : "normal";
        var root = document.documentElement;
        root.setAttribute("data-mode", mode);
        root.setAttribute("data-contrast", contrast);
        root.setAttribute("data-theme", mode + (contrast === "high" ? "-contrast" : ""));
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    {/* Seitenspezifische <head>-Eintraege (z. B. noindex, Redirect-Skripte der 404). */}
    <slot name="head" />
  </head>
  <body>
    <Header
      locale={locale}
      dictionary={dictionary}
      brand={brand}
      languageSwitchHref={languageSwitchHref}
    />
    <main>
      <slot />
    </main>
    {!isDocsPage && <MenuDrawer locale={locale} entries={docsEntries} />}
    <Footer locale={locale} dictionary={dictionary} brand={brand} />
  </body>
</html>
